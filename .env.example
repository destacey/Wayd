# Copy to .env and adjust. Docker Compose reads .env automatically; it is gitignored.

# ---------------------------------------------------------------------------
# SQL Server (the `mssql` service in docker-compose.yml)
# ---------------------------------------------------------------------------
# Must satisfy SQL Server's password policy (8+ chars, mixed case, digit/symbol).
# Changing it after the first `up` will NOT change the password already stored in
# the wayd-sqldata volume - remove the volume as well.
MSSQL_SA_PASSWORD=Wayd_Dev_P@ssw0rd!

# Host port for SQL Server. Override if 1433 is already in use locally.
MSSQL_PORT=1433

# ---------------------------------------------------------------------------
# Host paths mounted into the API container
# ---------------------------------------------------------------------------
# These live in different places per OS, and the casing differs - Linux is
# case-sensitive, so a Windows-shaped path will silently mount nothing.
#
# Linux / macOS (the defaults):
#   USER_SECRETS_DIR=~/.microsoft/usersecrets
#   HTTPS_CERT_DIR=~/.aspnet/https
#
# Windows:
#   USER_SECRETS_DIR=${APPDATA}/Microsoft/UserSecrets
#   HTTPS_CERT_DIR=${APPDATA}/ASP.NET/Https

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
API_BASE_URL=https://localhost:5001
