# Shell scripts must keep LF in the working tree regardless of core.autocrlf.
# A CRLF checkout turns the `#!/bin/sh` shebang into `/bin/sh\r`, and the kernel
# fails the exec with a "no such file or directory" that names a file which
# plainly exists — notably for the client image's ENTRYPOINT.
*.sh text eol=lf

# Git hooks have no extension but are executed the same way, so they need the
# same LF guarantee.
.githooks/* text eol=lf

# A Debug build of the API rewrites the OpenAPI document with LF on every platform.
# Under core.autocrlf=true git expects CRLF in the working tree, so an unchanged
# regeneration would otherwise show the file as modified.
Wayd.Web/src/Wayd.Web.Api/wwwroot/api/v1/specification.json text eol=lf

# The NSwag clients generated from it are written with LF too (newLineBehavior in each nswag config),
# so a regeneration on any platform produces the committed bytes.
Wayd.Web/src/wayd.web.reactclient/src/services/wayd-api.ts text eol=lf
Wayd.Tools/DataGeneration/src/Wayd.Tools.DataGeneration.Cli.Client/Generated/WaydApiClient.g.cs text eol=lf
