#!/bin/sh
# Reports a commit message that breaks docs/contributing/git-workflow.mdx. The convention is advisory:
# the warning is printed and the commit is kept.

if ! bash "$(git rev-parse --show-toplevel)/.github/scripts/commit-message-check.sh" "$1"; then
    echo "commit-msg: committed anyway -- the message convention is a warning, not a requirement." >&2
fi

exit 0
