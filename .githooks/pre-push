#!/bin/sh
# Refuses a push whose branch changes what @wayd/mcp publishes without adding a changeset -- the same
# check CI runs on the pull request, run here so it is caught before review. A change with no changeset
# merges cleanly and is never released. Bypass with `git push --no-verify`.

root="$(git rev-parse --show-toplevel)"

if ! git rev-parse --verify --quiet origin/main > /dev/null; then
    exit 0
fi

# A spec-only change is checked by regenerating the import formats, which needs the MCP's packages.
if [ ! -d "$root/Wayd.Web/src/Wayd.Mcp/node_modules" ]; then
    echo "pre-push: skipping the MCP changeset check; run 'npm ci' in Wayd.Web/src/Wayd.Mcp to enable it." >&2
    exit 0
fi

status=0

# Git passes each pushed ref on stdin, and it need not be the checked-out branch.
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$local_ref" in
        refs/heads/*) ;;
        *) continue ;;
    esac

    # An all-zero sha is a branch deletion; there is nothing to check.
    if [ -z "$(echo "$local_sha" | tr -d 0)" ]; then
        continue
    fi

    if ! output="$(bash "$root/.github/scripts/mcp-changeset-check.sh" origin/main "$local_sha" 2>/dev/null)"; then
        echo "pre-push: ${local_ref#refs/heads/}: $output" | sed 's/::error:://' >&2
        status=1
    fi
done

exit $status
