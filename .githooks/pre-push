#!/bin/sh
# Checks that each pushed branch's name follows docs/contributing/git-workflow.mdx before review.
# Bypass with `git push --no-verify`.

root="$(git rev-parse --show-toplevel)"

status=0

# Git passes each pushed ref on stdin, and it need not be the checked-out branch.
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$local_ref" in
        refs/heads/*) ;;
        *) continue ;;
    esac

    # An all-zero sha is a branch deletion; there is nothing to check.
    if [ -z "$(echo "$local_sha" | tr -d 0)" ]; then
        continue
    fi

    # The name that matters is the one the branch gets on the remote.
    if ! bash "$root/.github/scripts/branch-name-check.sh" "${remote_ref#refs/heads/}"; then
        status=1
    fi
done

exit $status
