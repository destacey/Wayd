<Project>

    <!--
        Stamp a Category trait onto every test assembly, so a Category=Unit test filter
        works without anyone hand-tagging classes. A project is Integration iff it references any
        Testcontainers package, the dependency that actually requires a Docker daemon;
        .github/scripts/dotnet-test-projects.sh splits CI on that same signal, so the trait a test
        carries and the job it runs in are derived from one fact rather than two conventions.

        Matched on the Testcontainers prefix, NOT on Testcontainers.MsSql specifically: a suite that
        reaches for a different module (Testcontainers.PostgreSql, .Redis, .RabbitMq) still needs Docker
        and still belongs in the integration job. Pinning the exact package would classify it Unit here
        while CI kept running it as an integration test, which is exactly the drift this derivation exists
        to prevent. Keep this in step with the grep in dotnet-test-projects.sh.

        This lives in Directory.Build.targets, not Directory.Build.props: props is imported before the SDK
        establishes TargetFramework, and a Target defined there is evaluated early enough to blank it out
        (NETSDK1013 on every project). targets is imported after the SDK, which is where build logic belongs.
    -->
    <Target Name="StampTestCategoryTrait" BeforeTargets="GetAssemblyAttributes" Condition="'$(IsTestProject)' == 'true'">
        <ItemGroup>
            <_WaydTestcontainersRef Include="@(PackageReference)" Condition="$([System.String]::Copy('%(Identity)').StartsWith('Testcontainers'))" />
        </ItemGroup>
        <PropertyGroup>
            <_WaydTestCategory Condition="'@(_WaydTestcontainersRef)' != ''">Integration</_WaydTestCategory>
            <_WaydTestCategory Condition="'$(_WaydTestCategory)' == ''">Unit</_WaydTestCategory>
        </PropertyGroup>
        <ItemGroup>
            <AssemblyAttribute Include="Xunit.TraitAttribute">
                <_Parameter1>Category</_Parameter1>
                <_Parameter2>$(_WaydTestCategory)</_Parameter2>
            </AssemblyAttribute>
        </ItemGroup>
    </Target>

    <!--
        Every test project carries the MTP extensions dotnet-test-projects.sh passes flags for
        (hang dump, coverage). Microsoft.Testing.Platform rejects an option no registered extension
        declares, so a project missing either one fails the whole run rather than just skipping the feature.
    -->
    <ItemGroup Condition="'$(IsTestProject)' == 'true'">
        <PackageReference Include="coverlet.MTP" />
        <PackageReference Include="Microsoft.Testing.Extensions.HangDump" />
    </ItemGroup>

    <!--
        Coverage settings live once in the repo-root testconfig.json and are copied next to each test
        assembly as $(AssemblyName).testconfig.json, the only place MTP and coverlet.MTP look for it. A config
        file makes coverlet authoritative (none of its built-in excludes apply), so it must list every rule.

        The excludes keep the percentage about hand-written code: without them the Wolverine handler tree
        (hundreds of generated files, regenerated on every handler change) swamps the number. EF migrations
        carry no [GeneratedCode] attribute, so they are excluded by path.

        A project with its own testconfig.json keeps it instead: MTP copies that one itself, and linking
        the shared file as well would put two files on the same output path.
    -->
    <ItemGroup Condition="'$(IsTestProject)' == 'true' And !Exists('$(MSBuildProjectDirectory)\testconfig.json')">
        <None Include="$(RepoRoot)testconfig.json" Link="$(AssemblyName).testconfig.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
