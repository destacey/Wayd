<Project>

    <!--
        Stamp a Category trait onto every test assembly, so a Category=Unit test filter
        works without anyone hand-tagging classes. A project is Integration iff it references Testcontainers,
        the dependency that actually requires a Docker daemon; .github/scripts/dotnet-test-projects.sh splits
        CI on that same signal, so the trait and the CI split cannot disagree.

        This lives in Directory.Build.targets, not Directory.Build.props: props is imported before the SDK
        establishes TargetFramework, and a Target defined there is evaluated early enough to blank it out
        (NETSDK1013 on every project). targets is imported after the SDK, which is where build logic belongs.
    -->
    <Target Name="StampTestCategoryTrait" BeforeTargets="GetAssemblyAttributes" Condition="'$(IsTestProject)' == 'true'">
        <PropertyGroup>
            <_WaydTestcontainersRefs>@(PackageReference->WithMetadataValue('Identity', 'Testcontainers.MsSql'))</_WaydTestcontainersRefs>
            <_WaydTestCategory Condition="'$(_WaydTestcontainersRefs)' != ''">Integration</_WaydTestCategory>
            <_WaydTestCategory Condition="'$(_WaydTestCategory)' == ''">Unit</_WaydTestCategory>
        </PropertyGroup>
        <ItemGroup>
            <AssemblyAttribute Include="Xunit.TraitAttribute">
                <_Parameter1>Category</_Parameter1>
                <_Parameter2>$(_WaydTestCategory)</_Parameter2>
            </AssemblyAttribute>
        </ItemGroup>
    </Target>

</Project>
