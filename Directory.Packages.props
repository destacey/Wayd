    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.SqlClient" Version="1.21.0" />
    <PackageVersion Include="RestSharp" Version="114.1.0" />
    <PackageVersion Include="Scalar.AspNetCore" Version="3.2.1" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Enrichers.AssemblyName" Version="2.0.0" />
    <PackageVersion Include="Serilog.Enrichers.Process" Version="3.0.0" />
    <PackageVersion Include="Serilog.Enrichers.Span" Version="3.1.0" />
    <PackageVersion Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageVersion Include="Serilog.Exceptions" Version="8.4.0" />
    <PackageVersion Include="Serilog.Expressions" Version="5.0.0" />
    <PackageVersion Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageVersion Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageVersion Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.Datadog.Logs" Version="0.6.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Serilog.Sinks.OpenTelemetry" Version="4.2.0" />
    <PackageVersion Include="Serilog.Sinks.Seq" Version="9.1.0" />
    <PackageVersion Include="SkiaSharp" Version="4.157.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.157.0" />
    <PackageVersion Include="SimplerSoftware.EntityFrameworkCore.SqlServer.NodaTime" Version="10.0.1" />
    <PackageVersion Include="System.CommandLine" Version="2.0.15" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.15" />
    <PackageVersion Include="WolverineFx" Version="6.65.1" />
    <PackageVersion Include="WolverineFx.EntityFrameworkCore" Version="6.65.1" />
    <PackageVersion Include="WolverineFx.FluentValidation" Version="6.65.1" />
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.65.1" />
    <PackageVersion Include="WolverineFx.SqlServer" Version="6.65.1" />
    <!-- Test packages -->
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <PackageVersion Include="coverlet.MTP" Version="10.1.1" />
    <PackageVersion Include="FluentAssertions" Version="[7.1.0]" />
    <!-- Keep on the Microsoft.Testing.Platform version xunit.v3 depends on (2.5.2 for xunit.v3 4.0.3). -->
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.5.3" />
    <!-- Referenced directly by Wayd.ArchitectureTests; NetArchTest.Rules needs 0.11.3 or later, and this one version serves both. -->
    <PackageVersion Include="Mono.Cecil" Version="0.11.6" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="Moq.AutoMock" Version="4.0.3" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="NodaTime.Testing" Version="3.3.7" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.17.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
</Project>