<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A Kiota-generated C# HTTP client for the Wayd API, used only by the wayd-data CLI dev tool. The
    client is generated from the checked-in OpenAPI document (Wayd.Web.Api/wwwroot/api/v1/specification.json)
    by the Kiota local tool (.config/dotnet-tools.json), and covers only the operations listed below.
    Not a deployed/production assembly.
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- The generated client is not our code; keep its warnings from failing or cluttering the build. -->
    <NoWarn>$(NoWarn);CS0108;CS1591</NoWarn>
    <WaydApiDocument>../../../../Wayd.Web/src/Wayd.Web.Api/wwwroot/api/v1/specification.json</WaydApiDocument>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Kiota.Bundle" />
  </ItemGroup>

  <!--
    The operations the tool calls, as Kiota path filters: the path as the document names it, then the methods.
    A new seeding call adds its operation here; CSV imports are posted by hand and need no entry.
  -->
  <ItemGroup>
    <KiotaIncludePath Include="/api/admin/feature-flags#GET" />
    <KiotaIncludePath Include="/api/admin/feature-flags/{id}/toggle#PUT" />
    <KiotaIncludePath Include="/api/demand-management/intake-channels#GET" />
    <KiotaIncludePath Include="/api/demand-management/intake-desks#GET,POST" />
    <KiotaIncludePath Include="/api/demand-management/intake-desks/estimation-scale-choices#GET" />
    <KiotaIncludePath Include="/api/demand-management/intake-desks/{id}/estimation-scale#PUT" />
    <KiotaIncludePath Include="/api/demand-management/intake-request-tag-categories#GET,POST" />
    <KiotaIncludePath Include="/api/demand-management/intake-request-tag-categories/{id}/active#PUT" />
    <KiotaIncludePath Include="/api/demand-management/intake-request-tag-categories/{id}/tags#POST" />
    <KiotaIncludePath Include="/api/demand-management/intake-request-tag-categories/{id}/tags/{tagId}/active#PUT" />
    <KiotaIncludePath Include="/api/demand-management/intake-requests/{id}/projects/{projectId}/deliverables#GET" />
    <KiotaIncludePath Include="/api/imports/definitions#GET" />
    <KiotaIncludePath Include="/api/imports/{id}#GET" />
    <KiotaIncludePath Include="/api/imports/{id}/rows#GET" />
    <KiotaIncludePath Include="/api/kpi-categories#GET,POST" />
    <KiotaIncludePath Include="/api/organization/team-member-roles#GET,POST" />
    <KiotaIncludePath Include="/api/ppm/expenditure-categories#GET,POST" />
    <KiotaIncludePath Include="/api/ppm/project-lifecycles#GET,POST" />
    <KiotaIncludePath Include="/api/ppm/project-lifecycles/{id}/activate#POST" />
    <KiotaIncludePath Include="/api/user-management/profiles#GET" />
    <KiotaIncludePath Include="/api/user-management/roles#GET,POST" />
    <KiotaIncludePath Include="/api/user-management/roles/{id}/permissions#PUT" />
    <KiotaIncludePath Include="/api/user-management/users#POST" />
  </ItemGroup>

  <!--
    Rewrites CRLF line endings as LF, byte for byte, leaving encoding and any byte-order mark alone. Kiota
    writes the platform's line ending, while .gitattributes commits the generated tree as LF; without this a
    regeneration on Windows shows every generated file as modified.
  -->
  <UsingTask TaskName="ConvertToLf" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        foreach (var file in Files)
        {
            var path = file.GetMetadata("FullPath");
            var bytes = File.ReadAllBytes(path);
            var lf = new MemoryStream(bytes.Length);
            for (var i = 0; i < bytes.Length; i++)
            {
                if (bytes[i] == (byte)'\r' && i + 1 < bytes.Length && bytes[i + 1] == (byte)'\n')
                {
                    continue;
                }

                lf.WriteByte(bytes[i]);
            }

            if (lf.Length != bytes.Length)
            {
                File.WriteAllBytes(path, lf.ToArray());
            }
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <!--
    Regenerate the client before compiling, but only when the document, this project (which holds the path
    list) or the pinned Kiota version has changed since the last generation here, so ordinary builds stay
    fast. The comparison is by content, against a stamp under obj/: git stamps every file it writes with the
    time of the checkout, so file times say nothing about whether the committed client is current. A missing
    lock file also regenerates, which is how CI forces a generation. An editor's design-time build never
    generates: it runs alongside a real build, and two Kiota runs over one folder fail on each other's files.
  -->
  <Target Name="GenerateWaydApiClient" BeforeTargets="BeforeCompile" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_WaydClientStampFile>$(BaseIntermediateOutputPath)wayd-api-client.inputs</_WaydClientStampFile>
      <!-- Properties outlive the target when a build host reuses the project, so start each run clean. -->
      <_WaydClientStamp />
      <_WaydClientIsStale>false</_WaydClientIsStale>
    </PropertyGroup>
    <GetFileHash Files="$(WaydApiDocument);$(MSBuildProjectFullPath);../../../../.config/dotnet-tools.json">
      <Output TaskParameter="Items" ItemName="_WaydClientInput" />
    </GetFileHash>
    <ReadLinesFromFile File="$(_WaydClientStampFile)" Condition="Exists('$(_WaydClientStampFile)')">
      <Output TaskParameter="Lines" PropertyName="_WaydClientStamp" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <_WaydClientInputsHash>@(_WaydClientInput->'%(FileHash)', '-')</_WaydClientInputsHash>
      <_WaydClientIsStale Condition="'$(_WaydClientInputsHash)' != '$(_WaydClientStamp)' Or !Exists('Generated/kiota-lock.json')">true</_WaydClientIsStale>
    </PropertyGroup>

    <Exec Condition="'$(_WaydClientIsStale)' == 'true'"
          ConsoleToMSBuild="true" ContinueOnError="true" WorkingDirectory="$(ProjectDir)" IgnoreStandardErrorWarningFormat="true" StandardOutputImportance="low"
          EnvironmentVariables="KIOTA_TUTORIAL_ENABLED=false;KIOTA_OFFLINE_ENABLED=true"
          Command="dotnet kiota generate --language CSharp --openapi &quot;$(WaydApiDocument)&quot; --output Generated --class-name WaydApiClient --namespace-name Wayd.Tools.DataGeneration.Cli.Client --exclude-backward-compatible --clean-output @(KiotaIncludePath->'--include-path &quot;%(Identity)&quot;', ' ')">
      <Output TaskParameter="ExitCode" PropertyName="KiotaExitCode" />
      <Output TaskParameter="ConsoleOutput" PropertyName="KiotaOutput" />
    </Exec>
    <Message Text="$(KiotaOutput)" Condition="'$(_WaydClientIsStale)' == 'true' And '$(KiotaExitCode)' == '0'" Importance="low" />
    <Error Text="Kiota could not generate the client. Run 'dotnet tool restore' from the repository root if the tool is missing.%0A$(KiotaOutput)" Condition="'$(_WaydClientIsStale)' == 'true' And '$(KiotaExitCode)' != '0'" />

    <ItemGroup Condition="'$(_WaydClientIsStale)' == 'true'">
      <_WaydGeneratedFile Include="Generated/**/*" Exclude="Generated/.kiota.log" />
    </ItemGroup>
    <ConvertToLf Files="@(_WaydGeneratedFile)" Condition="'$(_WaydClientIsStale)' == 'true'" />
    <WriteLinesToFile File="$(_WaydClientStampFile)" Lines="$(_WaydClientInputsHash)" Overwrite="true" Condition="'$(_WaydClientIsStale)' == 'true'" />

    <!--
      Compile items were globbed before generation ran; pick up files it added and drop ones it removed. The
      old items are removed by name: a wildcard Remove inside a target matches only files still on disk, so
      it would leave the ones Kiota deleted for the compiler to miss.
    -->
    <ItemGroup Condition="'$(_WaydClientIsStale)' == 'true'">
      <_WaydGeneratedCompile Include="@(Compile)" Condition="$([System.String]::Copy('%(Compile.Identity)').Replace('\', '/').StartsWith('Generated/'))" />
      <Compile Remove="@(_WaydGeneratedCompile)" />
      <Compile Include="Generated/**/*.cs" />
    </ItemGroup>
  </Target>

</Project>
