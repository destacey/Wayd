<Project Sdk="Microsoft.NET.Sdk">

  <!--
    wayd-data: a standalone dev tool that generates realistic organization data (people with a management
    tree + cross-functional teams) and seeds it into a Wayd environment exclusively through the public
    HTTP API's CSV import endpoints. Cross-platform (Windows + Linux containers). Authenticates with a
    Personal Access Token via the x-api-key header. Not a deployed/production assembly.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AssemblyName>wayd-data</AssemblyName>
    <RootNamespace>Wayd.Tools.DataGeneration.Cli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!--
      For the local `ui` page. A FrameworkReference rather than a package: the ASP.NET Core shared
      framework is already on any machine with the SDK, so serving a page costs no new dependency.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Bogus" />
    <PackageReference Include="CsvHelper" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wayd.Tools.DataGeneration.Cli.Client\Wayd.Tools.DataGeneration.Cli.Client.csproj" />

    <!--
      For the permission catalogue only. The tool still reaches the running system exclusively over HTTP;
      this is a compile-time reference so a role's permissions are looked up rather than spelled out.
      The roles endpoint stores whatever strings it is sent without checking them, so a renamed resource
      would otherwise be written as a claim that silently grants nothing.
    -->
    <ProjectReference Include="..\..\..\..\Wayd.Common\src\Wayd.Common.Domain\Wayd.Common.Domain.csproj" />

    <!--
      For EmailAddress.AllowedCharacters, so a generated address is built from the same grammar the API
      validates it against. Reachable transitively through Wayd.Common.Domain, but declared here because
      it is a direct dependency: relying on the transitive path would break confusingly the day that
      reference changed.
    -->
    <ProjectReference Include="..\..\..\..\Wayd.Common\src\Wayd.Common\Wayd.Common.csproj" />
  </ItemGroup>

  <!--
    Built-in recipes ship inside the assembly so the tool needs nothing beside it on disk. They are read
    through the same parser as a hand-written file, so a custom recipe can express anything a built-in
    can. The schema ships alongside them for `recipes schema` to write out.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Recipes\BuiltIn\*.json" />
    <EmbeddedResource Include="Recipes\recipe.schema.json" />
  </ItemGroup>

</Project>
