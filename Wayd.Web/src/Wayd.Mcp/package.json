{
  "name": "@wayd/mcp",
  "version": "0.16.2",
  "description": "MCP server for the Wayd work management API",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "wayd-mcp": "build/index.js"
  },
  "files": [
    "build",
    "src",
    "README.md"
  ],
  "scripts": {
    "start": "node build/index.js",
    "inspect": "npm run build && npx -y @modelcontextprotocol/inspector node build/index.js",
    "build": "npm run generate && tsc && node -e \"require('fs').chmodSync('build/index.js', 0o755)\"",
    "generate": "tsx scripts/generate-import-formats.ts && tsx scripts/generate-zod-schemas.ts",
    "lint": "eslint src tests scripts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json && tsc --noEmit -p tests/tsconfig.json",
    "test": "npm run build && npm run test:only",
    "test:only": "node --import tsx --test tests/**/*.test.ts",
    "prepare": "npm run build",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only",
    "release": "npm run build && changeset publish"
  },
  "keywords": [
    "mcp",
    "wayd",
    "model-context-protocol",
    "work-management",
    "project-management"
  ],
  "license": "MIT",
  "homepage": "https://wayd.dev",
  "bugs": {
    "url": "https://github.com/destacey/Wayd/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/destacey/Wayd.git",
    "directory": "Wayd.Web/src/Wayd.Mcp"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "axios": "^1.20.0",
    "dotenv": "^17.4.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
