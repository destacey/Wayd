    <PropertyGroup>
        <RunPostBuildEvent>OnBuildSuccess</RunPostBuildEvent>
    </PropertyGroup>
    <!-- Writes the OpenAPI document to wwwroot/api/v1/specification.json by building the real host and asking
         Microsoft.AspNetCore.OpenApi for it. WAYD_SKIP_DB_INIT keeps every piece of database-touching startup
         work from running (see HostIntrospection); Development keeps the production-only guards off.
         The tool starts the host's hosted services, so Wolverine:DisableDurableOutbox stops the outbox store from
         connecting to a database the build may not have (CI's deploy job has none). -->
    <Target Name="GenerateOpenApiDocument" AfterTargets="PostBuildEvent" Condition=" '$(Configuration)' == 'Debug' ">
        <Exec ConsoleToMSBuild="true" ContinueOnError="true" WorkingDirectory="$(ProjectDir)"
            EnvironmentVariables="ASPNETCORE_ENVIRONMENT=Development;WAYD_SKIP_DB_INIT=true;Wolverine__DisableDurableOutbox=true"
            Command="dotnet &quot;$(PkgMicrosoft_Extensions_ApiDescription_Server)/tools/dotnet-getdocument.dll&quot; --assembly &quot;$(TargetPath)&quot; --framework &quot;$(TargetFrameworkMoniker)&quot; --project &quot;$(MSBuildProjectName)&quot; --assets-file &quot;$(ProjectAssetsFile)&quot; --file-list &quot;$(ProjectDir)$(IntermediateOutputPath)OpenApiFiles.txt&quot; --output &quot;$(ProjectDir)wwwroot/api/v1&quot; --file-name specification --openapi-version OpenApi3_0">
            <Output TaskParameter="ExitCode" PropertyName="OpenApiExitCode" />
            <Output TaskParameter="ConsoleOutput" PropertyName="OpenApiOutput" />
        </Exec>

        <Message Text="$(OpenApiOutput)" Condition="'$(OpenApiExitCode)' == '0'" Importance="low" />
        <Error Text="$(OpenApiOutput)" Condition="'$(OpenApiExitCode)' != '0'" />
    </Target>

    <!-- Generates the TypeScript client from the document GenerateOpenApiDocument writes. -->
    <Target Name="NSwag" AfterTargets="GenerateOpenApiDocument" Condition=" '$(Configuration)' == 'Debug' ">
        <Exec ConsoleToMSBuild="true" ContinueOnError="true" WorkingDirectory="$(ProjectDir)"
            Command="$(NSwagExe_Net100) run nswag.json">
            <Output TaskParameter="ExitCode" PropertyName="NSwagExitCode" />
            <Output TaskParameter="ConsoleOutput" PropertyName="NSwagOutput" />
        </Exec>

        <Message Text="$(NSwagOutput)" Condition="'$(NSwagExitCode)' == '0'" Importance="low" />
        <Error Text="$(NSwagOutput)" Condition="'$(NSwagExitCode)' != '0'" />
    </Target>

    <!-- The Wolverine handler tree (Internal/Generated/WolverineHandlers) is NOT committed and NOT generated on
         every build. Local dev runs TypeLoadMode.Auto (Wolverine:CodegenMode=Auto in appsettings.Development.json,
         backed by WolverineFx.RuntimeCompilation), so a plain build/run needs no pre-generated tree — which is
         why the old RegenerateWolverineHandlers post-build target (a full app boot on every Debug build) is gone.
         The Static tree is generated by `codegen write` only in CI (once per pipeline run, shared as an artifact
         to the integration tests and the Docker image); see .github/workflows/docker.yml and the Dockerfile.
         To generate it locally (e.g. to reproduce a Static-mode issue), run `dotnet run` with the `codegen write`
         verb from this directory (WAYD_SKIP_DB_INIT=true plus any placeholder DatabaseSettings connection string);
         see .github/workflows/docker.yml for the exact command CI uses. -->
    <!-- The tree is compiled in only where it is generated fresh: CI (GitHub Actions sets CI=true) and the Docker
         build (WAYD_STATIC_HANDLERS=true). Auto mode loads a compiled handler type in preference to compiling
         one, and writes what it compiles back into this folder, so compiling a local tree freezes every handler
         at the moment it was written: a later change to a handler's dependencies silently keeps the old code.
         Set WAYD_STATIC_HANDLERS=true for both the build and the test run to exercise the Static path locally. -->
    <ItemGroup Condition=" '$(CI)' != 'true' And '$(WAYD_STATIC_HANDLERS)' != 'true' ">
        <Compile Remove="Internal\Generated\WolverineHandlers\**" />
    </ItemGroup>
