    "@types/react": "19.3.2",
    "@types/react-dom": "19.3.0",
    "browserslist": "^4.29.0"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "@swc/core": false,
    "esbuild": false,
    "protobufjs": false,
    "unrs-resolver": false
  }
