    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "baseline-browser-mapping": "^2.11.31",
    "esbuild": "^0.28.1",
    "eslint": "9.39.5",
