    "antd": "6.7.2",
    "antd-style": "^4.1.0",
    "d3-chord": "3.0.2",
    "d3-shape": "3.2.1",
    "dayjs": "1.11.23",
    "flexsearch": "^0.8.212",
    "gray-matter": "^4.0.3",
