{
  "name": "wayd.web.reactclient",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node -e \"require('fs').rmSync('.next', { recursive: true, force: true })\" && node scripts/build-search-index.mjs",
    "dev": "next dev --turbopack",
    "prebuild": "node scripts/build-search-index.mjs && npm run typecheck",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:deprecations": "eslint src -c eslint.deprecations.config.mjs",
    "typecheck": "tsc --noEmit",
    "generate:api": "orval",
    "generate:import-templates": "node scripts/generate-import-templates.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:docs": "vitest run --config vitest.docs.config.mts",
    "test:ci": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@antv/component": "2.1.12",
    "@serwist/turbopack": "^9.6.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/d3-chord": "3.0.6",
    "@types/d3-shape": "3.2.0",
    "@types/node": "26.6.10",
    "@types/react": "19.3.2",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "5.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "baseline-browser-mapping": "^2.11.39",
    "esbuild": "^0.28.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "hast-util-from-html": "^2.1.0",
    "hast-util-to-html": "^9.0.7",
    "jsdom": "31.0.1",
    "orval": "8.49.0",
    "prettier": "3.10.1",
    "rehype-stringify": "^10.0.1",
    "serwist": "^9.6.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  },
  "dependencies": {
    "@ant-design/charts": "2.6.7",
