{
  "name": "wayd.web.reactclient",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node -e \"require('fs').rmSync('.next', { recursive: true, force: true })\" && node scripts/build-search-index.mjs",
    "dev": "next dev --turbopack",
    "prebuild": "node scripts/build-search-index.mjs && npm run typecheck",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:deprecations": "eslint src -c eslint.deprecations.config.mjs",
    "typecheck": "tsc --noEmit",
    "generate:import-templates": "node scripts/generate-import-templates.mjs",
    "test": "jest",
    "test:coverage": "jest --coverage --ci",
    "test:docs": "jest --config jest.docs.config.ts --no-coverage",
    "test:ci": "jest --ci"
  },
  "devDependencies": {
    "@serwist/turbopack": "^9.5.13",
