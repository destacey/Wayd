<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsTestProject>true</IsTestProject>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FluentAssertions" />
        <PackageReference Include="Hangfire.InMemory" />
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
        <PackageReference Include="NJsonSchema" />
        <PackageReference Include="Testcontainers.MsSql" />
        <PackageReference Include="xunit.v3" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\src\Wayd.Web.Api\Wayd.Web.Api.csproj" />
      <ProjectReference Include="..\..\..\Wayd.Common\tests\Wayd.Tests.Containers\Wayd.Tests.Containers.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

    <ItemGroup>
        <!-- Durable-outbox integration tests inject the container connection string via a process
             environment variable (the only config source the host reads synchronously early enough for
             Wolverine's PersistMessagesWithSqlServer). Process env vars are global, so test collections
             must not run in parallel — see xunit.runner.json. -->
        <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <!-- The tools published before the hosted server, by the retired @wayd/mcp package; McpToolCatalogTests
             holds the hosted server to them. -->
        <Content Include="Mcp\published-tools.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <!-- The committed document, which OpenApiDocumentTests holds to the one the API generates. -->
        <None Include="..\..\src\Wayd.Web.Api\wwwroot\api\v1\specification.json" Link="OpenApi\specification.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
