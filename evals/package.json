{
  "name": "@wayd/skill-evals",
  "private": true,
  "description": "Measures whether the skills in skills/ make agents use the Wayd MCP tools correctly",
  "type": "module",
  "scripts": {
    "catalog": "tsx catalog.ts",
    "evals": "node --import tsx run-eval.mjs",
    "regrade": "tsx regrade.ts",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxlint": "^1.93.0",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild": false
  }
}
